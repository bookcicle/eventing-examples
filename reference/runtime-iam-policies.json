{
  "LambdaExecutionRole": {
    "AssumeRolePolicyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": {
            "Service": "lambda.amazonaws.com"
          },
          "Action": "sts:AssumeRole"
        }
      ]
    },
    "Policies": [
      {
        "PolicyName": "eventing-lambda-least-privilege",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Fn::If": [
                "RateLimitOn",
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:UpdateItem",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${DeploymentId}-${Stage}-rate-limits"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        {
                          "Fn::Sub": "${AWS::Region}:*"
                        }
                      ]
                    }
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            {
              "Sid": "AllowOwnLambdaEnvironmentDecrypt",
              "Effect": "Allow",
              "Action": "kms:Decrypt",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:kms:${AWS::Region}:${AWS::AccountId}:key/*"
              },
              "Condition": {
                "StringEquals": {
                  "kms:CallerAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ForAnyValue:StringEquals": {
                  "kms:ResourceAliases": "alias/aws/lambda"
                },
                "StringLike": {
                  "kms:EncryptionContext:aws:lambda:FunctionArn": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${DeploymentId}-${Stage}-ingest"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${DeploymentId}-${Stage}-ingest:*"
                    }
                  ]
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": {
                "Fn::GetAtt": "EventsIngestLogGroup.Arn"
              }
            },
            {
              "Effect": "Allow",
              "Action": {
                "Fn::If": [
                  "UseDurableBuffer",
                  "kinesis:PutRecords",
                  "firehose:PutRecordBatch"
                ]
              },
              "Resource": {
                "Fn::If": [
                  "UseDurableBuffer",
                  {
                    "Fn::GetAtt": "DurableIngressStream.Arn"
                  },
                  {
                    "Fn::GetAtt": "EventsDeliveryStream.Arn"
                  }
                ]
              }
            },
            {
              "Fn::If": [
                "UseDurableBuffer",
                {
                  "Effect": "Allow",
                  "Action": "kms:GenerateDataKey",
                  "Resource": {
                    "Fn::If": [
                      "HasCustomKmsKey",
                      {
                        "Ref": "KmsKeyArn"
                      },
                      {
                        "Fn::Sub": "arn:${AWS::Partition}:kms:${AWS::Region}:${AWS::AccountId}:key/*"
                      }
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "kms:EncryptionContext:aws:kinesis:arn": {
                        "Fn::GetAtt": "DurableIngressStream.Arn"
                      },
                      "kms:ViaService": {
                        "Fn::Sub": "kinesis.${AWS::Region}.${AWS::URLSuffix}"
                      }
                    },
                    "ForAnyValue:StringEquals": {
                      "Fn::If": [
                        "HasCustomKmsKey",
                        {
                          "Ref": "AWS::NoValue"
                        },
                        {
                          "kms:ResourceAliases": "alias/aws/kinesis"
                        }
                      ]
                    }
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "FirehoseDeliveryRole": {
    "AssumeRolePolicyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": {
            "Service": "firehose.amazonaws.com"
          },
          "Action": "sts:AssumeRole"
        }
      ]
    },
    "Policies": [
      {
        "PolicyName": "eventing-firehose-s3-delivery",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Fn::If": [
                "UseDurableBuffer",
                {
                  "Sid": "ReadDurableIngress",
                  "Effect": "Allow",
                  "Action": [
                    "kinesis:DescribeStream",
                    "kinesis:DescribeStreamSummary",
                    "kinesis:ListShards",
                    "kinesis:GetShardIterator",
                    "kinesis:GetRecords"
                  ],
                  "Resource": {
                    "Fn::GetAtt": "DurableIngressStream.Arn"
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            {
              "Fn::If": [
                "UseDurableBuffer",
                {
                  "Sid": "DecryptDurableIngress",
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": {
                    "Fn::If": [
                      "HasCustomKmsKey",
                      {
                        "Ref": "KmsKeyArn"
                      },
                      {
                        "Fn::Sub": "arn:${AWS::Partition}:kms:${AWS::Region}:${AWS::AccountId}:key/*"
                      }
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "kms:EncryptionContext:aws:kinesis:arn": {
                        "Fn::GetAtt": "DurableIngressStream.Arn"
                      },
                      "kms:ViaService": {
                        "Fn::Sub": "kinesis.${AWS::Region}.${AWS::URLSuffix}"
                      }
                    },
                    "ForAnyValue:StringEquals": {
                      "Fn::If": [
                        "HasCustomKmsKey",
                        {
                          "Ref": "AWS::NoValue"
                        },
                        {
                          "kms:ResourceAliases": "alias/aws/kinesis"
                        }
                      ]
                    }
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:AbortMultipartUpload",
                "s3:GetBucketLocation",
                "s3:GetObject",
                "s3:ListBucket",
                "s3:ListBucketMultipartUploads",
                "s3:PutObject"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": "CustomerEventsBucket.Arn"
                },
                {
                  "Fn::Sub": "${CustomerEventsBucket.Arn}/*"
                }
              ]
            },
            {
              "Fn::If": [
                "HasCustomKmsKey",
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Encrypt",
                    "kms:Decrypt",
                    "kms:GenerateDataKey"
                  ],
                  "Resource": {
                    "Ref": "KmsKeyArn"
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "EdgeRouterRole": {
    "AssumeRolePolicyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": {
            "Service": [
              "lambda.amazonaws.com",
              "edgelambda.amazonaws.com"
            ]
          },
          "Action": "sts:AssumeRole"
        }
      ]
    },
    "Policies": [
      {
        "PolicyName": "eventing-edge-router-logs",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowOwnLambdaEnvironmentDecrypt",
              "Effect": "Allow",
              "Action": "kms:Decrypt",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:kms:*:${AWS::AccountId}:key/*"
              },
              "Condition": {
                "StringEquals": {
                  "kms:CallerAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ForAnyValue:StringEquals": {
                  "kms:ResourceAliases": "alias/aws/lambda"
                },
                "StringLike": {
                  "kms:EncryptionContext:aws:lambda:FunctionArn": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:*:${AWS::AccountId}:function:${DeploymentId}-edge-router"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:*:${AWS::AccountId}:function:${DeploymentId}-edge-router:*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:*:${AWS::AccountId}:function:us-east-1.${DeploymentId}-edge-router"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:*:${AWS::AccountId}:function:us-east-1.${DeploymentId}-edge-router:*"
                    }
                  ]
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:*:${AWS::AccountId}:log-group:/aws/lambda/us-east-1.${DeploymentId}-edge-router"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:*:${AWS::AccountId}:log-group:/aws/lambda/us-east-1.${DeploymentId}-edge-router:*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:us-east-1:${AWS::AccountId}:log-group:/aws/lambda/${DeploymentId}-edge-router"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:logs:us-east-1:${AWS::AccountId}:log-group:/aws/lambda/${DeploymentId}-edge-router:*"
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
