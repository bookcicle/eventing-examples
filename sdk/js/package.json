{
  "name": "@bookcicle/eventing-sdk",
  "version": "2.0.0",
  "description": "Privacy-safe, zero-dependency JavaScript SDK for Eventing by Bookcicle",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./payloadHash": {
      "types": "./src/payloadHash.d.ts",
      "import": "./src/payloadHash.js"
    },
    "./nodeQueue": {
      "types": "./src/nodeQueue.d.ts",
      "import": "./src/nodeQueue.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "tsc --strict --noEmit --module nodenext --target es2022 test/types.mts && node --test test/*.test.mjs"
  },
  "license": "MIT",
  "types": "./src/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bookcicle/bookcicle-eventing.git",
    "directory": "sdk/js"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.4",
    "typescript": "^5.9.3"
  }
}
